{
  "id": "unit-10-lesson-01",
  "unit_id": "unit-10",
  "name": "-ere Verbs",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-10-lesson-01-tip-01",
      "title": "The -ere Pattern",
      "explanation": "Verbs ending in -ere follow this pattern: remove -ere and add -o (io), -i (tu), -e (lui/lei), -iamo (noi), -ete (voi), -ono (loro). 'scrivere' → scrivo, scrivi, scrive, scriviamo, scrivete, scrivono.",
      "before_exercise": 0
    },
    {
      "id": "unit-10-lesson-01-tip-02",
      "title": "Compare With -are",
      "explanation": "The io, tu and noi endings are the same as for -are verbs (-o, -i, -iamo). The differences are: lui/lei -e (not -a), voi -ete (not -ate), loro -ono (not -ano).",
      "before_exercise": 8
    },
    {
      "id": "unit-10-lesson-01-tip-03",
      "title": "Same Endings, New Verbs",
      "explanation": "Once you know the -ere endings, you can use any -ere verb: leggere (read), prendere (take), vivere (live), vedere (see), credere (believe), mettere (put).",
      "before_exercise": 14
    }
  ],
