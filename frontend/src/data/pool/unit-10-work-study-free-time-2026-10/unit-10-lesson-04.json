{
  "id": "unit-10-lesson-04",
  "unit_id": "unit-10",
  "name": "Work & Study",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-10-lesson-04-tip-01",
      "title": "Lavoro — Noun and Verb",
      "explanation": "'Lavoro' can be either the noun 'work / job' (il lavoro) or the 'io' form of 'lavorare' ('I work'). Context tells you which.",
      "before_exercise": 0
    },
    {
      "id": "unit-10-lesson-04-tip-02",
      "title": "At Work, At School",
      "explanation": "For 'at work' use 'al lavoro'; for 'at school' use 'a scuola' (no article); for 'at the office' use 'in ufficio'. These small prepositions are a bit fiddly — learn them as chunks.",
      "before_exercise": 6
    },
    {
      "id": "unit-10-lesson-04-tip-03",
      "title": "Professions",
      "explanation": "From Unit 2 you know dottore/dottoressa, studente/studentessa, insegnante. 'La professione' is the general word for job/career. 'Che lavoro fai?' = 'What do you do for work?'",
      "before_exercise": 11
    }
  ],
