{
  "id": "unit-19-lesson-01",
  "unit_id": "unit-19",
  "name": "The Weather",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-19-lesson-01-tip-01",
      "title": "Italian Weather Uses Fare and C'è",
      "explanation": "Italian uses 'fa' (3rd of fare) for temperature: 'fa caldo' (it's hot), 'fa freddo' (it's cold). And 'c'è' for visible weather: 'c'è il sole' (it's sunny), 'c'è il vento' (it's windy).",
      "before_exercise": 0
    },
    {
      "id": "unit-19-lesson-01-tip-02",
      "title": "Piove and Nevica",
      "explanation": "'Piove' (it's raining) and 'nevica' (it's snowing) are full sentences by themselves. The infinitives are 'piovere' and 'nevicare'. Used only in the 3rd person — no 'io piovo'.",
      "before_exercise": 6
    },
    {
      "id": "unit-19-lesson-01-tip-03",
      "title": "What's the Weather Like?",
      "explanation": "'Che tempo fa?' = 'How's the weather?' Literally 'What weather does it make?'. Answer with 'fa caldo / freddo' or 'c'è il sole / piove'.",
      "before_exercise": 12
    }
  ],
