  "vocabulary": [
    {
      "word": "che tempo fa?",
      "meaning": "what's the weather like? · il tempo = the weather (and time) · fa bel tempo = the weather's nice",
      "example": "Che tempo fa a Londra?",
      "phrase": true
    },
    { "word": "sole", "meaning": "sun · c'è il sole = it's sunny", "example": "Oggi c'è il sole." },
    { "word": "piovere", "meaning": "to rain · piove = it's raining, it rains", "example": "A Londra piove spesso." },
    { "word": "pioggia", "meaning": "rain", "example": "Non esco con questa pioggia." },
    { "word": "nevicare", "meaning": "to snow · nevica = it's snowing, it snows", "example": "In montagna nevica." },
    { "word": "neve", "meaning": "snow", "example": "C'è la neve in montagna." },
    { "word": "vento", "meaning": "wind · c'è vento = it's windy", "example": "Oggi c'è molto vento." },
    { "word": "nuvola", "meaning": "cloud", "example": "Nel cielo non c'è una nuvola." },
    { "word": "nuvoloso", "meaning": "cloudy", "example": "Oggi è nuvoloso, ma non piove." },
    { "word": "cielo", "meaning": "sky", "example": "Il cielo è azzurro." },
