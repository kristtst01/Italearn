  "name": "Months & Dates",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-19-lesson-03-tip-01",
      "title": "The Twelve Months",
      "explanation": "gennaio, febbraio, marzo, aprile, maggio, giugno, luglio, agosto, settembre, ottobre, novembre, dicembre. All masculine, all written with a small letter — not a capital like in English.",
      "before_exercise": 0
    },
    {
      "id": "unit-19-lesson-03-tip-02",
      "title": "Saying the Date",
      "explanation": "'Oggi è il 15 marzo' = Today is the 15th of March. Italian uses the article 'il' + number + month. The first day of the month is special: 'il primo marzo' (1st of March).",
      "before_exercise": 13
    },
    {
      "id": "unit-19-lesson-03-tip-03",
      "title": "When's Your Birthday?",
      "explanation": "'Quando è il tuo compleanno?' = 'When's your birthday?'. Answer: 'Il mio compleanno è il 10 agosto'. Use 'a' + month: 'a marzo' (in March).",
      "before_exercise": 17
    }
  ],
