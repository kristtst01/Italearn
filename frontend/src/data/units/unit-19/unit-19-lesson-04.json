  "name": "More Time Words",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-19-lesson-04-tip-01",
      "title": "Small Time Units",
      "explanation": "'Il secondo' (second), 'il minuto' (minute), 'l'attimo' (moment / instant). 'Un attimo, per favore' = One moment, please.",
      "before_exercise": 0
    },
    {
      "id": "unit-19-lesson-04-tip-02",
      "title": "Past, Present, Future",
      "explanation": "'Il passato' (past), 'il presente' (present), 'il futuro' (future). 'Scorso' (last) is the adjective: 'la settimana scorsa' = last week.",
      "before_exercise": 6
    },
    {
      "id": "unit-19-lesson-04-tip-03",
      "title": "Temperature",
      "explanation": "'La temperatura' = temperature. 'I gradi' = degrees. 'Trenta gradi' (30°). 'L'inizio' = the beginning.",
      "before_exercise": 11
    }
  ],
