{
  "id": "unit-10-lesson-02",
  "unit_id": "unit-10",
  "name": "-ire Verbs (Regular)",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-10-lesson-02-tip-01",
      "title": "The -ire Pattern",
      "explanation": "Verbs ending in -ire follow this pattern: remove -ire and add -o (io), -i (tu), -e (lui/lei), -iamo (noi), -ite (voi), -ono (loro). 'dormire' → dormo, dormi, dorme, dormiamo, dormite, dormono.",
      "before_exercise": 0
    },
    {
      "id": "unit-10-lesson-02-tip-02",
      "title": "Only Voi Changes",
      "explanation": "Compared to -ere verbs, only the voi form is different: -ite (not -ete). 'voi leggete' (-ere) but 'voi dormite' (-ire). Everything else is the same.",
      "before_exercise": 6
    },
    {
      "id": "unit-10-lesson-02-tip-03",
      "title": "Not All -ire Verbs Are Regular",
      "explanation": "Some -ire verbs add '-isc-' in some forms. You'll learn that pattern in the next lesson. For now, these five verbs are all fully regular.",
      "before_exercise": 11
    }
  ],
