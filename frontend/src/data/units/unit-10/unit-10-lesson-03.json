{
  "id": "unit-10-lesson-03",
  "unit_id": "unit-10",
  "name": "The -isc- Pattern",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-10-lesson-03-tip-01",
      "title": "The -isc- Twist",
      "explanation": "Some -ire verbs add '-isc-' between the stem and the ending in four forms: io, tu, lui/lei, loro. 'capire' → capisco, capisci, capisce, capiamo, capite, capiscono. Note: noi and voi are normal (capiamo, capite).",
      "before_exercise": 0
    },
    {
      "id": "unit-10-lesson-03-tip-02",
      "title": "The Boot Pattern",
      "explanation": "The -isc- forms make a 'boot' shape on the conjugation: io, tu, lui/lei, loro have -isc-, while noi and voi don't. This pattern (irregular at the edges, regular in the middle) shows up in other Italian verbs too.",
      "before_exercise": 7
    },
    {
      "id": "unit-10-lesson-03-tip-03",
      "title": "Which -ire Verbs Take -isc-?",
      "explanation": "There's no rule — you just learn it per verb. Common -isc- verbs: capire (understand), finire (finish), preferire (prefer), pulire (clean), spedire (send).",
      "before_exercise": 13
    }
  ],
