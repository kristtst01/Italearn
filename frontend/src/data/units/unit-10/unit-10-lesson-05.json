{
  "id": "unit-10-lesson-05",
  "unit_id": "unit-10",
  "name": "Free Time & Hobbies",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-10-lesson-05-tip-01",
      "title": "Free Time",
      "explanation": "'Il tempo libero' literally means 'free time'. 'Nel tempo libero' = 'in (one's) free time'. 'Nel tempo libero leggo' = 'In my free time I read'.",
      "before_exercise": 0
    },
    {
      "id": "unit-10-lesson-05-tip-02",
      "title": "Playing Sport vs. Playing a Game",
      "explanation": "Italian uses 'giocare a' + sport/game: 'gioco a calcio' (I play football), 'gioco a tennis'. For an instrument, it's 'suonare' (a separate verb you'll meet later).",
      "before_exercise": 6
    },
    {
      "id": "unit-10-lesson-05-tip-03",
      "title": "Going to the Cinema",
      "explanation": "'Vado al cinema' = 'I go to the cinema'. 'Guardo un film' = 'I watch a film'. 'Film' is a borrowed word and doesn't change in the plural: un film, due film.",
      "before_exercise": 12
    }
  ],
