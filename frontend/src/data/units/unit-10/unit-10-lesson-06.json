{
  "id": "unit-10-lesson-06",
  "unit_id": "unit-10",
  "name": "More -ere Verbs",
  "order": 6,
  "grammar_tips": [
    {
      "id": "unit-10-lesson-06-tip-01",
      "title": "Asking & Answering",
      "explanation": "'Chiedere' (to ask for) and 'rispondere' (to answer / respond) are the two halves of every conversation. Both regular -ere verbs.",
      "before_exercise": 0
    },
    {
      "id": "unit-10-lesson-06-tip-02",
      "title": "Winning & Losing",
      "explanation": "'Perdere' (to lose) and 'vincere' (to win) — for games, matches and life in general. 'Chi vince?' = Who's winning? 'Perdo sempre' = I always lose.",
      "before_exercise": 6
    },
    {
      "id": "unit-10-lesson-06-tip-03",
      "title": "Knowing People",
      "explanation": "'Conoscere' means to know a person, a place, or a thing (be familiar with). Different from 'sapere' (to know a fact — coming next lesson).",
      "before_exercise": 14
    }
  ],
  "exercises": [
