{
  "id": "unit-16-lesson-05",
  "unit_id": "unit-16",
  "name": "Vorrei & Some / Any",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-16-lesson-05-tip-01",
      "title": "Vorrei — Polite Ordering",
      "explanation": "'Vorrei' (I would like) is the polite request you use at a bar, café, restaurant, or shop. 'Vorrei un caffè', 'Vorrei la pasta'. Always softer than 'voglio'.",
      "before_exercise": 0
    },
    {
      "id": "unit-16-lesson-05-tip-02",
      "title": "Partitive — Some / Any",
      "explanation": "To say 'some' or 'any', Italian uses 'di + article' (the same fusion forms from Unit 13!): del (some + masc), della (some + fem), dei/degli/delle (some + plural). 'Vorrei del pane' = I'd like some bread.",
      "before_exercise": 7
    },
    {
      "id": "unit-16-lesson-05-tip-03",
      "title": "Same Forms, New Use",
      "explanation": "'Del', 'della', 'dei' you already know as 'of the'. Here they mean 'some / any'. Context tells you which: 'la pagina del libro' (of the book) vs 'vorrei del pane' (some bread).",
      "before_exercise": 13
    }
  ],
