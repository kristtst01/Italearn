{
  "id": "unit-16-lesson-01",
  "unit_id": "unit-16",
  "name": "Food Basics",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-16-lesson-01-tip-01",
      "title": "Staples",
      "explanation": "The staple food words: il pane (bread), la pasta, il riso, la carne (meat), il pesce (fish), l'uovo (egg). Most A1 food conversations use this core set.",
      "before_exercise": 0
    },
    {
      "id": "unit-16-lesson-01-tip-02",
      "title": "Uova — Irregular Plural",
      "explanation": "'L'uovo' (egg) is masculine singular, but its plural 'le uova' is feminine plural! It's a quirky Latin leftover — just learn it as an exception.",
      "before_exercise": 7
    },
    {
      "id": "unit-16-lesson-01-tip-03",
      "title": "Frutta & Verdura",
      "explanation": "'La frutta' (fruit) and 'la verdura' (vegetables) are usually used in the singular as collective nouns — like 'fruit' in English. 'Mangio la frutta' = I eat fruit (in general).",
      "before_exercise": 13
    }
  ],
