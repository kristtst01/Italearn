    {
      "id": "unit-16-lesson-03-tip-01",
      "title": "Italian Drinks",
      "explanation": "Common drinks: il caffè (you know it), il tè, il latte (milk), il succo (juice), il vino (wine), la birra (beer), l'acqua (water).",
      "before_exercise": 0
    },
    {
      "id": "unit-16-lesson-03-tip-02",
      "title": "A Glass / A Bottle",
      "explanation": "'Un bicchiere di vino' = a glass of wine. 'Una bottiglia di acqua' = a bottle of water. Use 'di' (no article) between container and drink.",
      "before_exercise": 7
    }
  ],
