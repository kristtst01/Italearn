  "name": "At the Café & Restaurant",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-16-lesson-04-tip-01",
      "title": "Bar vs Café",
      "explanation": "In Italy 'il bar' isn't a pub — it's a café where you go for coffee, a pastry or a quick lunch. 'Il ristorante' is for a sit-down meal.",
      "before_exercise": 0
    },
    {
      "id": "unit-16-lesson-04-tip-02",
      "title": "Italian Meal Courses",
      "explanation": "A traditional Italian meal: l'antipasto (starter), il primo (first course, usually pasta), il secondo (main, meat/fish), il contorno (side), il dolce (dessert). You don't have to order all five!",
      "before_exercise": 7
    },
    {
      "id": "unit-16-lesson-04-tip-03",
      "title": "The Bill",
      "explanation": "'Il conto, per favore' = The bill, please. 'Cameriere' = waiter, 'cameriera' = waitress. 'Il menù' is the menu (note the accent — it stays the same in plural too).",
      "before_exercise": 13
    }
  ],
