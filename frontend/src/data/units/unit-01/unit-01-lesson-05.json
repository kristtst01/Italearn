{
  "id": "unit-01-lesson-05",
  "unit_id": "unit-01",
  "name": "Wishes & Set Phrases",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-01-lesson-05-tip-01",
      "title": "Buon + Event",
      "explanation": "Italians wish each other well constantly. The pattern is 'buon/buona/buoni/buone' (good) + the occasion: 'Buon compleanno!' (Happy birthday!), 'Buon viaggio!' (Have a good trip!), 'Buone vacanze!' (Happy holidays!).",
      "before_exercise": 0
    },
    {
      "id": "unit-01-lesson-05-tip-02",
      "title": "Auguri & Complimenti",
      "explanation": "'Auguri!' is a one-word 'best wishes!' for any occasion. 'Complimenti!' = well done / congratulations. 'Congratulazioni!' is more formal — used for big achievements (marriage, graduation).",
      "before_exercise": 6
    },
    {
      "id": "unit-01-lesson-05-tip-03",
      "title": "Daily Wishes",
      "explanation": "'Buona giornata!' (Have a good day!), 'Buona serata!' (Have a good evening!), 'Buon appetito!' (Enjoy your meal!) — these are said constantly. Italians never just say 'bye' without one of these.",
      "before_exercise": 12
    }
  ],
