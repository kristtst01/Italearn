{
  "id": "unit-07-lesson-05",
  "unit_id": "unit-07",
  "name": "Languages & Speaking",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-07-lesson-05-tip-01",
      "title": "The Verb Parlare",
      "explanation": "'Parlare' means to speak. Like all -are verbs (you'll see more in Unit 9), the forms change: 'parlo' (I speak), 'parli' (you speak), 'parla' (he/she speaks).",
      "before_exercise": 0
    },
    {
      "id": "unit-07-lesson-05-tip-02",
      "title": "Languages = Masculine Nationality",
      "explanation": "A language has the same name as the masculine nationality: italiano, inglese, francese. 'Parlo inglese' (I speak English), 'Marco parla francese' (Marco speaks French).",
      "before_exercise": 6
    },
    {
      "id": "unit-07-lesson-05-tip-03",
      "title": "A Little",
      "explanation": "'Un po'' means 'a little'. 'Parlo un po' di italiano' = 'I speak a little Italian'. Use 'molto' for 'a lot' and 'poco' for 'little/not much'.",
      "before_exercise": 12
    }
  ],
