{
  "id": "unit-07-lesson-01",
  "unit_id": "unit-07",
  "name": "European Countries",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-07-lesson-01-tip-01",
      "title": "Country Names",
      "explanation": "Many Italian country names look close to English: Italia, Francia, Spagna. They are always written with a capital letter, and most are feminine: l'Italia, la Francia.",
      "before_exercise": 0
    },
    {
      "id": "unit-07-lesson-01-tip-02",
      "title": "In + Country",
      "explanation": "To say where something is located, use 'in' before a country: 'Roma è in Italia', 'Parigi è in Francia'. No article is needed.",
      "before_exercise": 7
    },
    {
      "id": "unit-07-lesson-01-tip-03",
      "title": "City vs Country",
      "explanation": "From Unit 2 you know 'Sono di Roma'. 'Di' is for cities. 'In' is for countries: 'Sono di Roma, in Italia'. The capital ('la capitale') is the main city of a country.",
      "before_exercise": 13
    }
  ],
