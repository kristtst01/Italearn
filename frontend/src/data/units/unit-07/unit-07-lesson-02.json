  "name": "Countries Around the World",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-07-lesson-02-tip-01",
      "title": "Beyond Europe",
      "explanation": "More country names: most still end in -a (Cina, Russia, Australia) and are feminine. A few — like 'il Brasile', 'il Giappone', 'gli Stati Uniti' — are masculine.",
      "before_exercise": 0
    },
    {
      "id": "unit-07-lesson-02-tip-02",
      "title": "Stati Uniti — Plural",
      "explanation": "'Gli Stati Uniti' (the United States) is plural — 'they are united states'. You'll often hear 'America' for the country in everyday speech.",
      "before_exercise": 6
    },
    {
      "id": "unit-07-lesson-02-tip-03",
      "title": "World, City, Country",
      "explanation": "Three useful words together: 'il mondo' (the world), 'la città' (the city), 'il paese' (the country). 'La città' is feminine but ends in -à, not -a.",
      "before_exercise": 11
    }
  ],
