{
  "id": "unit-07-lesson-03",
  "unit_id": "unit-07",
  "name": "Nationalities I (-o/-a)",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-07-lesson-03-tip-01",
      "title": "Nationalities Are Adjectives",
      "explanation": "A nationality word is an adjective — it agrees just like the adjectives from Unit 6. 'Marco è italiano' (masculine), 'Anna è italiana' (feminine). Same -o/-a rule you already know.",
      "before_exercise": 0
    },
    {
      "id": "unit-07-lesson-03-tip-02",
      "title": "No Article",
      "explanation": "With 'essere' + a nationality, don't use an article: 'Sono italiano', not 'sono un italiano'. Just the verb and the nationality.",
      "before_exercise": 6
    },
    {
      "id": "unit-07-lesson-03-tip-03",
      "title": "Nationality Pairs",
      "explanation": "Most -o/-a nationalities pair masculine/feminine: italiano/italiana, spagnolo/spagnola, tedesco/tedesca, russo/russa, americano/americana. Same word, just change the ending.",
      "before_exercise": 12
    }
  ],
