{
  "id": "unit-07-lesson-04",
  "unit_id": "unit-07",
  "name": "Nationalities II (-e)",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-07-lesson-04-tip-01",
      "title": "Nationalities Ending in -e",
      "explanation": "Some nationalities end in -e: francese, inglese, cinese, giapponese, portoghese, canadese. Like 'grande' or 'gentile', these don't change for gender — 'un uomo francese', 'una donna francese'.",
      "before_exercise": 0
    },
    {
      "id": "unit-07-lesson-04-tip-02",
      "title": "Plural: -i",
      "explanation": "In the plural, -e nationalities take -i: 'due ragazzi francesi', 'tre amiche inglesi'. The plural is the same for masculine and feminine.",
      "before_exercise": 7
    },
    {
      "id": "unit-07-lesson-04-tip-03",
      "title": "Spotting -ese Words",
      "explanation": "Many -e nationalities end in -ese: francese, inglese, portoghese, cinese, giapponese, canadese. The -ese ending is a clue you're looking at a nationality.",
      "before_exercise": 12
    }
  ],
