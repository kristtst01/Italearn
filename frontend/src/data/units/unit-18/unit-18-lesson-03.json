{
  "id": "unit-18-lesson-03",
  "unit_id": "unit-18",
  "name": "Preferring & Comparing",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-18-lesson-03-tip-01",
      "title": "Preferire — Recap",
      "explanation": "From Unit 10: 'preferire' is an -isc- verb. 'Preferisco il caffè al tè' = 'I prefer coffee to tea'. The 'to' is 'a' (or 'a' + article).",
      "before_exercise": 0
    },
    {
      "id": "unit-18-lesson-03-tip-02",
      "title": "More and Less",
      "explanation": "'Più' = more. 'Meno' = less. To compare: 'più ... di / che' (more than), 'meno ... di / che' (less than). 'Il caffè è più caro del tè' = Coffee is more expensive than tea.",
      "before_exercise": 6
    },
    {
      "id": "unit-18-lesson-03-tip-03",
      "title": "Piuttosto",
      "explanation": "'Piuttosto' = rather. 'Piuttosto che' = rather than. 'Bevo il tè piuttosto che il caffè' = I drink tea rather than coffee.",
      "before_exercise": 12
    }
  ],
