{
  "id": "unit-18-lesson-04",
  "unit_id": "unit-18",
  "name": "Liking & Feeling",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-18-lesson-04-tip-01",
      "title": "Love & Hate",
      "explanation": "Beyond 'mi piace', use 'amare' (to love) and 'odiare' (to hate) for stronger feelings. 'Amo la pasta', 'Odio il freddo'.",
      "before_exercise": 0
    },
    {
      "id": "unit-18-lesson-04-tip-02",
      "title": "Reflexive Feelings",
      "explanation": "Many feeling verbs are reflexive: 'sentirsi' (to feel), 'divertirsi' (to have fun / enjoy oneself), 'annoiarsi' (to be bored), 'fidarsi' (to trust). All use mi/ti/si pronouns.",
      "before_exercise": 5
    },
    {
      "id": "unit-18-lesson-04-tip-03",
      "title": "Mancare & Dispiacere",
      "explanation": "'Mi manca' = I miss it (literally: it is lacking to me). 'Mi dispiace' = I'm sorry (literally: it displeases me). Both work like 'piacere'.",
      "before_exercise": 11
    }
  ],
