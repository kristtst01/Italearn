{
  "id": "unit-18-lesson-02",
  "unit_id": "unit-18",
  "name": "Things You Like to Do",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-18-lesson-02-tip-01",
      "title": "Mi Piace + Infinitive",
      "explanation": "To say you like doing something, use 'mi piace' + infinitive: 'Mi piace leggere' (I like reading), 'Mi piace ballare' (I like dancing). Always 'piace' (singular) with an infinitive.",
      "before_exercise": 0
    },
    {
      "id": "unit-18-lesson-02-tip-02",
      "title": "Hobbies & Activities",
      "explanation": "Common A1 activities: ballare (dance), cantare (sing), nuotare (swim), correre (run), viaggiare (travel), suonare (play an instrument), disegnare (draw).",
      "before_exercise": 7
    },
    {
      "id": "unit-18-lesson-02-tip-03",
      "title": "Saying You Don't Like",
      "explanation": "'Non mi piace ballare' (I don't like dancing). Put 'non' before the pronoun. To soften it: 'non mi piace tanto' (I don't like it much).",
      "before_exercise": 13
    }
  ],
