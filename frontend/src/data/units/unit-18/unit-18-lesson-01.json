{
  "id": "unit-18-lesson-01",
  "unit_id": "unit-18",
  "name": "Mi Piace, Mi Piacciono",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-18-lesson-01-tip-01",
      "title": "Piacere — A Different Logic",
      "explanation": "Italian doesn't say 'I like pizza' — it says 'pizza is pleasing to me': 'Mi piace la pizza'. The thing liked is the SUBJECT of the verb, you are the OBJECT.",
      "before_exercise": 0
    },
    {
      "id": "unit-18-lesson-01-tip-02",
      "title": "Singular or Plural",
      "explanation": "If the thing liked is singular: 'Mi piace la pizza'. If plural: 'Mi piacciono le pizze'. The verb agrees with WHAT you like, not with you.",
      "before_exercise": 6
    },
    {
      "id": "unit-18-lesson-01-tip-03",
      "title": "Who Likes — The Pronoun Changes",
      "explanation": "'Mi piace' (I like), 'ti piace' (you like), 'gli piace' (he likes), 'le piace' (she likes), 'ci piace' (we like), 'vi piace' (you all like), 'a loro piace' (they like).",
      "before_exercise": 12
    }
  ],
  "exercises": [
