      "subtype": "multiple_choice",
      "prompt": { "text": "What does 'mi piace' mean?" },
      "sentence_context": "Mi piace la pizza.",
      "correct_answer": "I like",
      "distractors": ["You like", "He likes", "I would like"],
      "hints": ["Literally: 'it pleases me'."],
      "target_words": ["piacere"]
