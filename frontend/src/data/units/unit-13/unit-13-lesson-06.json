  "name": "Direction & Time",
  "order": 6,
  "grammar_tips": [
    {
      "id": "unit-13-lesson-06-tip-01",
      "title": "Forward & Back",
      "explanation": "'Avanti' (forward / ahead), 'indietro' (back / backwards). 'Avanti!' = Come in! / Go ahead! 'Torna indietro' = Go back.",
      "before_exercise": 0
    },
    {
      "id": "unit-13-lesson-06-tip-02",
      "title": "Against, Without, Toward",
      "explanation": "'Contro' (against), 'senza' (without), 'verso' (toward). 'Vado verso casa' = I'm heading home. 'Senza zucchero' = without sugar.",
      "before_exercise": 5
    },
    {
      "id": "unit-13-lesson-06-tip-03",
      "title": "During, Through, Along, Around",
      "explanation": "'Durante' (during), 'attraverso' (through / across), 'lungo' (along — also means 'long'!), 'intorno' (around).",
      "before_exercise": 11
    }
  ],
