{
  "id": "unit-13-lesson-05",
  "unit_id": "unit-13",
  "name": "Imperative & Location Adverbs",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-13-lesson-05-tip-01",
      "title": "Telling Someone What to Do",
      "explanation": "The informal imperative (commands to a friend) is short and direct. For -are verbs: take the 'lui/lei' form: 'parla!' (speak!), 'guarda!' (look!), 'mangia!' (eat!). For -ere/-ire verbs: use the 'tu' form: 'scrivi!' (write!), 'apri!' (open!).",
      "before_exercise": 0
    },
    {
      "id": "unit-13-lesson-05-tip-02",
      "title": "Negative Imperative",
      "explanation": "To tell someone NOT to do something, use 'non' + the infinitive: 'Non parlare!' (Don't speak!), 'Non mangiare!' (Don't eat!). Different from positive — uses the dictionary form.",
      "before_exercise": 6
    },
    {
      "id": "unit-13-lesson-05-tip-03",
      "title": "Inside, Outside, Above, Below",
      "explanation": "Four more location words to complete your spatial set: 'dentro' (inside), 'fuori' (outside), 'sopra' (above / on), 'sotto' (under).",
      "before_exercise": 12
    }
  ],
