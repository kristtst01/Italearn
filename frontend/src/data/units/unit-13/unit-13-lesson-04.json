  "name": "Asking & Giving Directions",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-13-lesson-04-tip-01",
      "title": "Right, Left, Straight",
      "explanation": "'A destra' = on/to the right. 'A sinistra' = on/to the left. '(Sempre) dritto' = (straight) ahead. These are the three you'll hear most.",
      "before_exercise": 0
    },
    {
      "id": "unit-13-lesson-04-tip-02",
      "title": "Near & Far",
      "explanation": "'Vicino a' = near (to). 'Lontano da' = far (from). 'Davanti a' = in front of. 'Dietro' = behind. These describe location.",
      "before_exercise": 6
    },
    {
      "id": "unit-13-lesson-04-tip-03",
      "title": "Asking for Directions",
      "explanation": "'Dov'è la stazione?' = Where is the station? Answer: 'È a destra, vicino alla banca' = It's to the right, near the bank. Combine direction + reference point.",
      "before_exercise": 11
    }
  ],
