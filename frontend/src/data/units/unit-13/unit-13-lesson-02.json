{
  "id": "unit-13-lesson-02",
  "unit_id": "unit-13",
  "name": "Articulated Prepositions",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-13-lesson-02-tip-01",
      "title": "Preposition + Article = One Word",
      "explanation": "When the prepositions a, di, da, in, su meet a definite article (il, lo, la, l', i, gli, le), they fuse into ONE word: a + il = al, di + la = della, in + il = nel, etc.",
      "before_exercise": 0
    },
    {
      "id": "unit-13-lesson-02-tip-02",
      "title": "The Fusion Table",
      "explanation": "Examples: al (a+il), allo (a+lo), alla (a+la), all' (a+l'), ai (a+i), agli (a+gli), alle (a+le). Same pattern for di→del, da→dal, in→nel, su→sul. 'Con' and 'per' do NOT fuse.",
      "before_exercise": 7
    },
    {
      "id": "unit-13-lesson-02-tip-03",
      "title": "If You Know the Article, You Know the Fusion",
      "explanation": "Knowing 'lo' triggers (lo studente, lo zaino) means knowing 'allo studente', 'allo zaino'. The fusion uses the same article rules from Unit 3.",
      "before_exercise": 13
    }
  ],
