{
  "id": "unit-13-lesson-01",
  "unit_id": "unit-13",
  "name": "Simple Prepositions",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-13-lesson-01-tip-01",
      "title": "The Eight Core Prepositions",
      "explanation": "Italian's main prepositions are: di (of/from), a (to/at), da (from/at someone's), in (in/into), con (with), su (on), per (for/through), tra/fra (between/among). You've already met di and in.",
      "before_exercise": 0
    },
    {
      "id": "unit-13-lesson-01-tip-02",
      "title": "A vs In for Places",
      "explanation": "'A' is for cities and most specific places: 'a Roma', 'a casa', 'a scuola'. 'In' is for countries, regions, and broad areas: 'in Italia', 'in cucina', 'in centro'. Tricky at first — learn the common pairings.",
      "before_exercise": 6
    },
    {
      "id": "unit-13-lesson-01-tip-03",
      "title": "Tra and Fra",
      "explanation": "'Tra' and 'fra' mean the same thing — between, among, in [time]. Both are correct: 'tra amici' or 'fra amici'. Italians choose based on what sounds smoother; either is safe.",
      "before_exercise": 12
    }
  ],
