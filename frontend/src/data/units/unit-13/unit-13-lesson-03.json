  "name": "Places in the City",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-13-lesson-03-tip-01",
      "title": "Practical Places",
      "explanation": "Common places you go in a city: la banca, la farmacia, il supermercato, la stazione, l'ospedale, la chiesa, l'ufficio postale, la piazza, il museo. Most are feminine if they end in -a.",
      "before_exercise": 0
    },
    {
      "id": "unit-13-lesson-03-tip-02",
      "title": "Andare A vs Andare In",
      "explanation": "'Al supermercato', 'alla farmacia', 'in banca', 'in piazza', 'in centro'. Some places take 'a + article', others take 'in' (no article). It's idiomatic — learn the common ones.",
      "before_exercise": 8
    },
    {
      "id": "unit-13-lesson-03-tip-03",
      "title": "Via — Street",
      "explanation": "'La via' = the street. Italian addresses are 'Via [name], numero [N]': 'Via Roma, 10'. 'Piazza' is a square, 'corso' is an avenue.",
      "before_exercise": 14
    }
  ],
