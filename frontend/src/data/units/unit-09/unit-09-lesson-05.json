{
  "id": "unit-09-lesson-05",
  "unit_id": "unit-09",
  "name": "Days & Parts of the Day",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-09-lesson-05-tip-01",
      "title": "Parts of the Day",
      "explanation": "Use 'la mattina' (in the morning), 'il pomeriggio' (in the afternoon), 'la sera' (in the evening), 'la notte' (at night) to say when something happens.",
      "before_exercise": 0
    },
    {
      "id": "unit-09-lesson-05-tip-02",
      "title": "Days of the Week",
      "explanation": "Italian days of the week: lunedì, martedì, mercoledì, giovedì, venerdì (all masculine, end in -ì), sabato, domenica. They start with a small letter — not a capital like in English.",
      "before_exercise": 7
    },
    {
      "id": "unit-09-lesson-05-tip-03",
      "title": "On Monday",
      "explanation": "To say 'on Monday', just use the day: 'lunedì lavoro' = 'on Monday I work'. To say 'on Mondays' (every Monday), add 'il': 'il lunedì lavoro' = 'on Mondays I work'.",
      "before_exercise": 14
    }
  ],
