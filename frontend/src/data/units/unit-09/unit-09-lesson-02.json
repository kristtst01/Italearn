{
  "id": "unit-09-lesson-02",
  "unit_id": "unit-09",
  "name": "More -are Verbs",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-09-lesson-02-tip-01",
      "title": "Same Pattern, More Verbs",
      "explanation": "All the new verbs in this lesson use the same -are pattern from Lesson 1. Once you know the stem, you know all six forms. Practice the pattern with new meanings.",
      "before_exercise": 0
    },
    {
      "id": "unit-09-lesson-02-tip-02",
      "title": "Verbs With -care and -gare",
      "explanation": "'Giocare' (to play) and 'cercare' (to look for) end in -care. In the 'tu' and 'noi' forms they add an 'h' to keep the hard 'c' sound: tu giochi, noi giochiamo. Same for -gare verbs.",
      "before_exercise": 10
    }
  ],
