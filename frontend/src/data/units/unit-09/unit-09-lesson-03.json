{
  "id": "unit-09-lesson-03",
  "unit_id": "unit-09",
  "name": "Reflexive Verbs",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-09-lesson-03-tip-01",
      "title": "Reflexive Verbs",
      "explanation": "Some verbs describe an action you do to yourself. 'Mi lavo' = I wash myself. They use a small pronoun before the verb: mi (myself), ti (yourself), si (himself/herself), ci (ourselves), vi (yourselves), si (themselves).",
      "before_exercise": 0
    },
    {
      "id": "unit-09-lesson-03-tip-02",
      "title": "Pronoun Before the Verb",
      "explanation": "The reflexive pronoun comes before the verb: 'mi sveglio' (I wake up), 'ti svegli' (you wake up), 'si sveglia' (he/she wakes up). The verb itself takes the normal -are endings.",
      "before_exercise": 6
    },
    {
      "id": "unit-09-lesson-03-tip-03",
      "title": "Mi Chiamo Was Reflexive",
      "explanation": "You've used a reflexive verb since Unit 2: 'mi chiamo' literally means 'I call myself'. The infinitive is 'chiamarsi'. Now you can see why it's 'mi chiamo' and not just 'chiamo'.",
      "before_exercise": 12
    },
    {
      "id": "unit-09-lesson-03-tip-04",
      "title": "Infinitive Ends in -si",
      "explanation": "In the dictionary, a reflexive verb ends in -si: svegliarsi (to wake up), lavarsi (to wash), addormentarsi (to fall asleep). When you use it, drop -si and add the right pronoun + verb form.",
      "before_exercise": 18
    }
  ],
