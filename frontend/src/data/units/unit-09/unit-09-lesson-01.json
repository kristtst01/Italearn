{
  "id": "unit-09-lesson-01",
  "unit_id": "unit-09",
  "name": "The -are Pattern",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-09-lesson-01-tip-01",
      "title": "The -are Pattern",
      "explanation": "Most Italian verbs end in -are. To use one, remove -are and add the ending for the person: -o (io), -i (tu), -a (lui/lei), -iamo (noi), -ate (voi), -ano (loro). 'parlare' → parlo, parli, parla, parliamo, parlate, parlano.",
      "before_exercise": 0
    },
    {
      "id": "unit-09-lesson-01-tip-02",
      "title": "Drop the Subject",
      "explanation": "The ending already tells you who's speaking, so Italian usually drops the pronoun. 'Studio l'italiano' already means 'I study Italian' — you don't need to say 'io'.",
      "before_exercise": 8
    },
    {
      "id": "unit-09-lesson-01-tip-03",
      "title": "Stem + Ending",
      "explanation": "Always think of the verb as two parts: the stem (the bit before -are) plus the ending. 'lavorare' → stem 'lavor-' + ending. 'Io lavoro', 'tu lavori', 'lui lavora'.",
      "before_exercise": 14
    }
  ],
