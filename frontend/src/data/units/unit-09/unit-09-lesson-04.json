  "name": "Telling the Time",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-09-lesson-04-tip-01",
      "title": "Telling the Time",
      "explanation": "For most times use 'sono le' + number: 'Sono le tre' (3:00), 'Sono le dieci' (10:00). For 1:00, noon and midnight use 'è': 'È l'una', 'È mezzogiorno', 'È mezzanotte'.",
      "before_exercise": 0
    },
    {
      "id": "unit-09-lesson-04-tip-02",
      "title": "Half and Quarter",
      "explanation": "'e mezza' = half past. 'e un quarto' = quarter past. 'meno un quarto' = quarter to. 'Sono le tre e mezza' (3:30), 'Sono le tre meno un quarto' (2:45).",
      "before_exercise": 8
    },
    {
      "id": "unit-09-lesson-04-tip-03",
      "title": "At + Time",
      "explanation": "To say 'at [time]', use 'alle' + number: 'alle sette' (at 7:00). For 1:00, noon, midnight, use 'all'una', 'a mezzogiorno', 'a mezzanotte'.",
      "before_exercise": 14
    }
  ],
