{
  "id": "unit-06-lesson-03",
  "unit_id": "unit-06",
  "name": "Colours",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-06-lesson-03-tip-01",
      "title": "Colours Are Adjectives",
      "explanation": "Colours work like other adjectives — they come after the noun and agree with it: 'un libro rosso' (a red book), 'una penna rossa' (a red pen).",
      "before_exercise": 0
    },
    {
      "id": "unit-06-lesson-03-tip-02",
      "title": "Colours Ending in -e",
      "explanation": "'Verde' (green) ends in -e, so like 'grande' it doesn't change for gender: 'il tavolo verde', 'la porta verde'.",
      "before_exercise": 8
    },
    {
      "id": "unit-06-lesson-03-tip-03",
      "title": "Invariable Colours",
      "explanation": "Some colours never change at all: 'blu', 'viola', 'rosa'. 'Il cane blu', 'la macchina blu' — always 'blu'. They have just one form.",
      "before_exercise": 15
    }
  ],
