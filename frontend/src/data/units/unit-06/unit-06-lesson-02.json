{
  "id": "unit-06-lesson-02",
  "unit_id": "unit-06",
  "name": "New, Old & Condition",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-06-lesson-02-tip-01",
      "title": "Describing Condition",
      "explanation": "These adjectives describe the state of a thing — new or old, clean or dirty, full or empty. They agree with the noun and come after it: 'una macchina nuova', 'un tavolo pulito'.",
      "before_exercise": 0
    },
    {
      "id": "unit-06-lesson-02-tip-02",
      "title": "Opposites Help",
      "explanation": "Learn these as pairs of opposites: nuovo/vecchio (new/old), pulito/sporco (clean/dirty), pieno/vuoto (full/empty). Pairs are easier to remember together.",
      "before_exercise": 7
    },
    {
      "id": "unit-06-lesson-02-tip-03",
      "title": "Bello Before the Noun",
      "explanation": "'Bello' often comes before the noun and can change shape there (un bel cane). At A1, the safe rule is to place it after the noun like other adjectives: 'un cane bello' is also fine.",
      "before_exercise": 13
    }
  ],
