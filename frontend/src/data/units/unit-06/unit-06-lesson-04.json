{
  "id": "unit-06-lesson-04",
  "unit_id": "unit-06",
  "name": "Good, Bad & Useful",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-06-lesson-04-tip-01",
      "title": "Judging Things",
      "explanation": "These adjectives give an opinion about a thing — good or bad, easy or hard, right or wrong. They agree with the noun like all adjectives: 'un libro buono', 'una lezione facile'.",
      "before_exercise": 0
    },
    {
      "id": "unit-06-lesson-04-tip-02",
      "title": "More -e Adjectives",
      "explanation": "'Facile' (easy), 'difficile' (hard) and 'importante' (important) end in -e, so they don't change for gender: 'un libro difficile', 'una domanda difficile'.",
      "before_exercise": 8
    },
    {
      "id": "unit-06-lesson-04-tip-03",
      "title": "Caro Has Two Meanings",
      "explanation": "'Caro' means both 'expensive' and 'dear'. 'Una macchina cara' = an expensive car; 'caro amico' = dear friend. Context tells you which.",
      "before_exercise": 14
    }
  ],
