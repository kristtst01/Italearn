    { "word": "biondo", "meaning": "blond, fair", "example": "Emma è bionda." },
    { "word": "castano", "meaning": "brown (hair and eyes)", "example": "Ho i capelli castani." },
    { "word": "azzurro", "meaning": "light blue, blue (eyes, sky)", "example": "Ha gli occhi azzurri." },
    { "word": "barba", "meaning": "beard", "example": "Tomás ha la barba." },
    { "word": "maschio", "meaning": "male; a boy (babies, animals)", "example": "È maschio o femmina?" },
    { "word": "femmina", "meaning": "female; a girl (babies, animals)", "example": "Il gatto di Chloé è femmina." }
