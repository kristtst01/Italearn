  "name": "Size & Shape",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-06-lesson-01-tip-01",
      "title": "Adjectives Agree",
      "explanation": "An Italian adjective changes its ending to match the noun. A masculine noun takes -o, a feminine noun takes -a: 'il gatto piccolo' (the small cat), 'la casa piccola' (the small house).",
      "before_exercise": 0
    },
    {
      "id": "unit-06-lesson-01-tip-02",
      "title": "After the Noun",
      "explanation": "Unlike English, most Italian adjectives come AFTER the noun. 'A big house' is 'una casa grande' — literally 'a house big'.",
      "before_exercise": 6
    },
    {
      "id": "unit-06-lesson-01-tip-03",
      "title": "Adjectives Ending in -e",
      "explanation": "Some adjectives end in -e, like 'grande'. These do NOT change for gender: 'il libro grande' and 'la porta grande' both use 'grande'. One form for masculine and feminine.",
      "before_exercise": 12
    }
  ],
