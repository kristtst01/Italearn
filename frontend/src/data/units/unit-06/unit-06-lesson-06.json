{
  "id": "unit-06-lesson-06",
  "unit_id": "unit-06",
  "name": "More Adjectives",
  "order": 6,
  "grammar_tips": [
    {
      "id": "unit-06-lesson-06-tip-01",
      "title": "More Useful Adjectives",
      "explanation": "Italian has many adjectives you'll meet every day: stesso (same), sicuro (sure), strano (strange), diverso (different), prossimo (next), possibile (possible). All agree like the adjectives from earlier lessons.",
      "before_exercise": 0
    },
    {
      "id": "unit-06-lesson-06-tip-02",
      "title": "Strong Opinions",
      "explanation": "'Fantastico' (fantastic) and 'ottimo' (excellent) are common reactions. 'Che fantastico!' = How fantastic! 'Un'idea ottima' = An excellent idea.",
      "before_exercise": 7
    },
    {
      "id": "unit-06-lesson-06-tip-03",
      "title": "Personality & State",
      "explanation": "'Tranquillo' (calm), 'serio' (serious), 'normale' (normal), 'semplice' (simple), 'sano' (healthy), 'naturale' (natural). All -o/-a adjectives except 'semplice' and 'naturale' (which is -e? no, naturale is -e). Actually 'naturale' ends in -e too — same form for both genders.",
      "before_exercise": 14
    }
  ],
