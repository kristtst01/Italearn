{
  "id": "unit-06-lesson-05",
  "unit_id": "unit-06",
  "name": "Personality & Feelings",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-06-lesson-05-tip-01",
      "title": "Describing People",
      "explanation": "To say what someone is like, use 'essere' + an adjective: 'Marco è simpatico', 'Anna è gentile'. The adjective agrees with the person.",
      "before_exercise": 0
    },
    {
      "id": "unit-06-lesson-05-tip-02",
      "title": "Personality in -e",
      "explanation": "Many personality adjectives end in -e: gentile, intelligente, forte, triste. Like 'grande', these don't change for gender — 'un ragazzo gentile', 'una ragazza gentile'.",
      "before_exercise": 8
    },
    {
      "id": "unit-06-lesson-05-tip-03",
      "title": "Feelings Change",
      "explanation": "Some of these describe a lasting trait (simpatico, intelligente) and some a passing feeling (stanco, contento, nervoso). Italian uses 'essere' for both: 'Sono stanco' = I am tired right now.",
      "before_exercise": 16
    }
  ],
