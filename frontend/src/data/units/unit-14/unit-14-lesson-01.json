{
  "id": "unit-14-lesson-01",
  "unit_id": "unit-14",
  "name": "Means of Transport",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-14-lesson-01-tip-01",
      "title": "How You Travel",
      "explanation": "Italian uses 'in' for most vehicles: 'in treno', 'in autobus', 'in macchina', 'in aereo'. The exception is 'a piedi' (on foot), which uses 'a'.",
      "before_exercise": 0
    },
    {
      "id": "unit-14-lesson-01-tip-02",
      "title": "Andare + In + Transport",
      "explanation": "'Vado a Roma in treno' = I go to Rome by train. 'Andiamo in macchina' = We're going by car. 'Vado al lavoro a piedi' = I walk to work.",
      "before_exercise": 6
    },
    {
      "id": "unit-14-lesson-01-tip-03",
      "title": "Singular Transport Names",
      "explanation": "Most transport names are masculine: il treno, l'autobus, il taxi, l'aereo, il metro. 'La macchina' and 'la bicicletta' (from earlier units) are feminine.",
      "before_exercise": 11
    }
  ],
