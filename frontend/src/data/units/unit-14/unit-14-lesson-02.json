{
  "id": "unit-14-lesson-02",
  "unit_id": "unit-14",
  "name": "Buying a Ticket",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-14-lesson-02-tip-01",
      "title": "Asking for a Ticket",
      "explanation": "'Un biglietto per Roma, per favore' = 'A ticket to Rome, please'. Add 'di sola andata' (one way) or 'andata e ritorno' (return / round trip) to specify.",
      "before_exercise": 0
    },
    {
      "id": "unit-14-lesson-02-tip-02",
      "title": "Costare",
      "explanation": "'Quanto costa?' = How much does it cost? 'Costa venti euro' = It costs 20 euros. The verb 'costare' is regular -are: costo, costi, costa, costiamo, costate, costano.",
      "before_exercise": 7
    },
    {
      "id": "unit-14-lesson-02-tip-03",
      "title": "Partire vs Arrivare",
      "explanation": "'Partire' (to leave) and 'arrivare' (to arrive). 'Il treno parte alle otto' (The train leaves at eight). 'Il treno arriva alle dieci' (The train arrives at ten).",
      "before_exercise": 13
    }
  ],
