    { "word": "binario", "meaning": "platform, track · binari (plural)", "example": "Il treno per Bologna parte dal binario sei." },
    { "word": "ritardo", "meaning": "delay · in ritardo = late", "example": "Il treno è in ritardo di dieci minuti." },
    { "word": "diretto", "meaning": "direct", "example": "È un treno diretto: non devo cambiare." },
    { "word": "durare", "meaning": "to last, to take (time)", "example": "Il viaggio dura due ore." },
