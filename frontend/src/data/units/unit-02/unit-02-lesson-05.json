  "name": "Spelling & The Alphabet",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-02-lesson-05-tip-01",
      "title": "L'Alfabeto Italiano",
      "explanation": "Italian has 21 letters in its standard alphabet (no j, k, w, x, y in native words — they only appear in foreign borrowings). Letter names: a, bi, ci, di, e, effe, gi, acca, i, elle, emme, enne, o, pi, qu, erre, esse, ti, u, vu, zeta.",
      "before_exercise": 0
    },
    {
      "id": "unit-02-lesson-05-tip-02",
      "title": "Spelling Your Name",
      "explanation": "'Come si scrive?' = 'How do you spell it?'. Reply by saying each letter: 'M-A-R-C-O'. Useful on the phone or with new acquaintances.",
      "before_exercise": 5
    },
    {
      "id": "unit-02-lesson-05-tip-03",
      "title": "Doppia — Double Letters",
      "explanation": "Many Italian words have double consonants ('mamma', 'caffè', 'anno'). When spelling, you say 'doppia' (double) before the letter: 'M-A-doppia M-A' for 'mamma'.",
      "before_exercise": 10
    }
  ],
