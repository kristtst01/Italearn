      "subtype": "dialogue_completion",
      "prompt": { "text": "The receptionist continues." },
      "sentence_context": "Receptionist: Piacere. Lei è americano?\nYou: ___",
      "correct_answer": ["Sì, sono americano.", "No, non sono americano. Sono inglese."],
