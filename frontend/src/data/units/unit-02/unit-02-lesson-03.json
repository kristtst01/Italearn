      "correct_answer": "Anch'io!",
      "distractors": ["Anche sono!", "Anche tu!"],
      "hints": ["'Me too' is anch'io."],
      "target_words": ["anche"]
    },
    {
      "id": "unit-02-lesson-03-ex-06",
