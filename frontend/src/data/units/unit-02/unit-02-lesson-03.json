      "subtype": "dialogue_completion",
      "prompt": { "text": "At a party, a friend introduces you to someone." },
      "sentence_context": "Giulia: Emma, questo è Marco.\nMarco: Ciao, piacere!\nYou: ___",
      "correct_answer": ["Piacere!", "Ciao, piacere!", "Piacere mio!"],
