      "hints": ["Answer the greeting."],
      "target_words": ["piacere"],
      "dialogue": [
        { "speaker": "Giulia", "text": "Emma, questo è Marco." },
        { "speaker": "Marco", "text": "Ciao, piacere!" },
        { "speaker": "You" }
      ]
    },
    {
