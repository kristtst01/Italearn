  "exercises": [
    {
      "id": "unit-02-lesson-04-ex-01",
      "type": "vocab",
      "subtype": "type_answer",
      "prompt": { "text": "What does 'chi è?' mean?" },
      "sentence_context": "Chi è? È Marco.",
      "correct_answer": ["who is it?", "who is he?", "who is she?"],
      "distractors": [],
      "hints": ["'Chi' = who."],
      "target_words": ["chi è"]
    },
    {
      "id": "unit-02-lesson-04-ex-02",
      "type": "vocab",
      "subtype": "multiple_choice",
      "prompt": { "text": "You introduce your friend Sara to your teacher. What do you say?" },
      "sentence_context": "",
      "correct_answer": "Questa è Sara.",
      "distractors": ["Questo è Sara.", "Lei sono Sara."],
      "hints": ["Sara is a woman: questa."],
      "target_words": ["questa è"]
    },
    {
      "id": "unit-02-lesson-04-ex-03",
      "type": "writing",
      "subtype": "cloze",
      "prompt": { "text": "Complete: This is Paul. He is American." },
      "sentence_context": "___ è Paul. È americano.",
      "correct_answer": ["Questo", "questo"],
      "distractors": [],
      "hints": ["Paul is a man."],
      "target_words": ["questo è"]
    },
    {
      "id": "unit-02-lesson-04-ex-04",
      "type": "vocab",
      "subtype": "multiple_choice",
      "prompt": { "text": "Someone points at a man across the room and asks \"Chi è?\". It's Marco, a doctor. What do you answer?" },
      "sentence_context": "Chi è?",
      "correct_answer": "È Marco. È medico.",
      "distractors": ["Sono Marco. Sono medico.", "È Marco. Sei medico."],
      "hints": ["Talking about him: è."],
      "target_words": ["chi è"]
    },
    {
      "id": "unit-02-lesson-04-ex-05",
      "type": "writing",
      "subtype": "cloze",
      "prompt": { "text": "Complete: Emma's from London. Paul is from London too." },
      "sentence_context": "Emma è di Londra. ___ Paul è di Londra.",
      "correct_answer": ["Anche", "anche"],
      "distractors": [],
      "hints": ["'Too' goes before the person it's about."],
      "target_words": ["anche"]
    },
    {
      "id": "unit-02-lesson-04-ex-06",
      "type": "writing",
      "subtype": "dialogue_completion",
      "prompt": { "text": "A friend asks about the woman you are with." },
      "sentence_context": "Friend: Chi è?\nYou: ___",
      "correct_answer": ["È Giulia. È insegnante.", "Questa è Giulia, è di Firenze."],
      "distractors": [],
      "hints": ["Her name, and something about her."],
      "target_words": ["chi è"],
      "dialogue": [
        { "speaker": "Friend", "text": "Chi è?" },
        { "speaker": "You" }
      ]
    },
    {
      "id": "unit-02-lesson-04-ex-07",
      "type": "vocab",
      "subtype": "multiple_choice",
      "prompt": { "text": "\"Lei è di Roma.\" Your friend Marco says this while looking at his colleague Anna. Who is from Rome?" },
      "sentence_context": "Lei è di Roma.",
      "correct_answer": "Anna",
      "distractors": ["You", "Marco"],
      "hints": ["Lowercase lei = she."],
      "target_words": ["lei"]
    },
    {
      "id": "unit-02-lesson-04-ex-08",
      "type": "writing",
      "subtype": "cloze",
      "prompt": { "text": "Complete: They are from Madrid." },
      "sentence_context": "___ sono di Madrid.",
      "correct_answer": ["Loro", "loro"],
      "distractors": [],
      "hints": ["'They'."],
      "target_words": ["loro"]
    },
    {
      "id": "unit-02-lesson-04-ex-09",
      "type": "writing",
      "subtype": "arrange_words",
      "prompt": { "text": "Arrange: 'This is Keiko. She's Japanese and she's an engineer.'" },
      "sentence_context": "Questa è Keiko. È giapponese ed è ingegnere.",
      "correct_answer": ["Questa", "è", "Keiko.", "È", "giapponese", "ed", "è", "ingegnere."],
      "distractors": ["Questo", "sono"],
      "hints": ["Before a vowel, 'e' (and) often becomes 'ed'."],
      "target_words": ["questa è"]
    },
    {
      "id": "unit-02-lesson-04-ex-10",
      "type": "writing",
      "subtype": "type_answer",
      "prompt": { "text": "Introduce your friend Luca, a waiter from Naples." },
      "sentence_context": "",
      "correct_answer": ["questo è Luca, è cameriere, è di Napoli", "questo è Luca. è cameriere di Napoli", "questo è Luca, cameriere, di Napoli"],
      "distractors": [],
      "hints": ["Questo è + name, then what he does and where he is from."],
      "target_words": ["questo è"]
    },
    {
      "id": "unit-02-lesson-04-ex-11",
      "type": "writing",
      "subtype": "type_answer",
      "prompt": { "text": "Say that Anna and Marta aren't Italian: they're Spanish." },
      "sentence_context": "",
      "correct_answer": ["Anna e Marta non sono italiane, sono spagnole", "non sono italiane, sono spagnole"],
      "distractors": [],
      "hints": ["Two women: -e for the plural."],
      "target_words": ["spagnolo"]
    }
  ],
  "vocabulary": [
    { "word": "questo è", "meaning": "this is (a man)", "example": "Questo è Marco." },
    { "word": "questa è", "meaning": "this is (a woman)", "example": "Questa è Giulia." },
    { "word": "chi è", "meaning": "who is it? who is he/she?", "example": "Chi è? È Paul." },
    { "word": "lui", "meaning": "he", "example": "Lui è medico." },
