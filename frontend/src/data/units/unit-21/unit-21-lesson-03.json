{
  "id": "unit-21-lesson-03",
  "unit_id": "unit-21",
  "name": "Sightseeing & Travel",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-21-lesson-03-tip-01",
      "title": "Being a Tourist",
      "explanation": "'Il turista' / 'la turista' (tourist) — same word both genders, only the article changes. You'll often hear 'i turisti' for a group.",
      "before_exercise": 0
    },
    {
      "id": "unit-21-lesson-03-tip-02",
      "title": "Things to See",
      "explanation": "'Il monumento' (monument), 'la fontana' (fountain), 'il museo' (you know it). Many Italian towns have all three around a single piazza.",
      "before_exercise": 5
    },
    {
      "id": "unit-21-lesson-03-tip-03",
      "title": "Map & Guide",
      "explanation": "'La mappa' = map. 'La guida' has two meanings: a tour guide (person) OR a guidebook. 'Una foto' = a photo (short for fotografia).",
      "before_exercise": 10
    }
  ],
  "exercises": [
