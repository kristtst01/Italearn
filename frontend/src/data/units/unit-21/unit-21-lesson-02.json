  "name": "Checking In",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-21-lesson-02-tip-01",
      "title": "Passport & Documents",
      "explanation": "At Italian hotels you usually need to show 'il passaporto' (passport) or 'la carta d'identità' (ID card) when checking in. You may also fill in 'il modulo' (form).",
      "before_exercise": 0
    },
    {
      "id": "unit-21-lesson-02-tip-02",
      "title": "Luggage",
      "explanation": "'La valigia' (suitcase, plural valigie) and 'il bagaglio' (luggage, often used in singular as a collective). 'Dov'è il mio bagaglio?' = Where's my luggage?",
      "before_exercise": 6
    },
    {
      "id": "unit-21-lesson-02-tip-03",
      "title": "Signing",
      "explanation": "'Firma qui' = Sign here. 'La firma' = the signature. Used a lot when checking in or paying.",
      "before_exercise": 10
    }
  ],
