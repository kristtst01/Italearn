{
  "id": "unit-21-lesson-01",
  "unit_id": "unit-21",
  "name": "At the Hotel",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-21-lesson-01-tip-01",
      "title": "Albergo & Hotel",
      "explanation": "Italian uses both 'l'albergo' (more traditional) and 'l'hotel' (modern loan) for hotels. Both are masculine. 'La camera' is the room (same word as bedroom in a house).",
      "before_exercise": 0
    },
    {
      "id": "unit-21-lesson-01-tip-02",
      "title": "Booking",
      "explanation": "'Prenotare' = to book / reserve. 'Vorrei prenotare una camera' = I'd like to book a room. 'La prenotazione' = the reservation.",
      "before_exercise": 6
    },
    {
      "id": "unit-21-lesson-01-tip-03",
      "title": "Singola or Doppia",
      "explanation": "'Una camera singola' = single room. 'Una camera doppia' = double room. 'Per quante notti?' = For how many nights?",
      "before_exercise": 11
    }
  ],
