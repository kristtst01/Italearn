  "name": "The Body",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-20-lesson-01-tip-01",
      "title": "Body Basics",
      "explanation": "Italian for body parts: la testa (head), gli occhi (eyes), il naso (nose), la bocca (mouth), le orecchie (ears), i capelli (hair — always plural in Italian!).",
      "before_exercise": 0
    },
    {
      "id": "unit-20-lesson-01-tip-02",
      "title": "Limbs",
      "explanation": "La gamba (leg), il braccio (arm), la mano (hand — feminine despite ending in -o!), il dito (finger). Some have unusual plurals: il braccio → le braccia, il dito → le dita.",
      "before_exercise": 8
    },
    {
      "id": "unit-20-lesson-01-tip-03",
      "title": "I Capelli — Always Plural",
      "explanation": "In Italian 'hair' is always plural: 'i capelli'. 'Ho i capelli neri' = I have black hair. Saying 'il capello' refers to one single strand — unusual.",
      "before_exercise": 14
    }
  ],
