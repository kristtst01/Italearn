{
  "id": "unit-20-lesson-03",
  "unit_id": "unit-20",
  "name": "At the Pharmacy",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-20-lesson-03-tip-01",
      "title": "Italian Pharmacies",
      "explanation": "Italian 'farmacie' do a lot more than US/UK pharmacies — they give advice, recommend over-the-counter medicines, and often the 'farmacista' (pharmacist) is a first stop before a doctor.",
      "before_exercise": 0
    },
    {
      "id": "unit-20-lesson-03-tip-02",
      "title": "Medicine, Prescription, Pill",
      "explanation": "'La medicina' = medicine. 'La ricetta' is both a prescription AND a (cooking) recipe — context decides. 'La pillola' or 'la pastiglia' = pill / tablet.",
      "before_exercise": 6
    },
    {
      "id": "unit-20-lesson-03-tip-03",
      "title": "Asking for Help",
      "explanation": "'Mi serve qualcosa per la tosse' = I need something for the cough. 'Avere bisogno di' (Unit 5) also works: 'Ho bisogno di una medicina'. Both are very common.",
      "before_exercise": 12
    }
  ],
