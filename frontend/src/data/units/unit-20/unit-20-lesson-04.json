  "name": "More Health & Body",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-20-lesson-04-tip-01",
      "title": "More Body Parts",
      "explanation": "Two more body words: 'la faccia' (face) and 'il corpo' (body). 'Mi fa male la faccia' = My face hurts. 'Il corpo umano' = the human body.",
      "before_exercise": 0
    },
    {
      "id": "unit-20-lesson-04-tip-02",
      "title": "Health Words",
      "explanation": "'La salute' (health), 'la malattia' (illness), 'la cura' (treatment / care), 'il sangue' (blood). 'Salute!' is also said when someone sneezes — like 'Bless you!'",
      "before_exercise": 6
    },
    {
      "id": "unit-20-lesson-04-tip-03",
      "title": "Alive & Well",
      "explanation": "'Vivo' (alive / living) and 'morto' (dead). 'Sono vivo!' = I'm alive! 'Fisico' (physical), 'paziente' (patient — both noun and adjective), 'energia' (energy).",
      "before_exercise": 12
    }
  ],
