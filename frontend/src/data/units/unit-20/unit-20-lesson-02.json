{
  "id": "unit-20-lesson-02",
  "unit_id": "unit-20",
  "name": "How Are You Feeling?",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-20-lesson-02-tip-01",
      "title": "Stare for Health",
      "explanation": "'Come stai?' (How are you?) — uses 'stare'. 'Sto bene' (I'm well), 'sto male' (I'm unwell), 'sto meglio' (I'm better). Always 'stare', not 'essere', for health.",
      "before_exercise": 0
    },
    {
      "id": "unit-20-lesson-02-tip-02",
      "title": "Ho Mal Di...",
      "explanation": "To say something hurts: 'Ho mal di' + body part. 'Ho mal di testa' (I have a headache), 'ho mal di gola' (I have a sore throat), 'ho mal di schiena' (I have a backache).",
      "before_exercise": 6
    },
    {
      "id": "unit-20-lesson-02-tip-03",
      "title": "Mi Fa Male",
      "explanation": "Another way: 'mi fa male' + body part. 'Mi fa male la testa' = my head hurts. For plural body parts (like le gambe): 'mi fanno male le gambe' = my legs hurt.",
      "before_exercise": 12
    }
  ],
