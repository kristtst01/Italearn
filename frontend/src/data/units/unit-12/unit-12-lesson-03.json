{
  "id": "unit-12-lesson-03",
  "unit_id": "unit-12",
  "name": "Stare, Dare & Dire",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-12-lesson-03-tip-01",
      "title": "Stare",
      "explanation": "'Stare' (to stay / be in a state): sto, stai, sta, stiamo, state, stanno. You already know it from 'Come stai?' — it's for health and states. 'Sto bene', 'Marco sta male'.",
      "before_exercise": 0
    },
    {
      "id": "unit-12-lesson-03-tip-02",
      "title": "Dare",
      "explanation": "'Dare' (to give): do, dai, dà, diamo, date, danno. Note 'dà' has an accent so you don't confuse it with 'da' (from). 'Mi dai il libro?' = Can you give me the book?",
      "before_exercise": 7
    },
    {
      "id": "unit-12-lesson-03-tip-03",
      "title": "Dire",
      "explanation": "'Dire' (to say / tell): dico, dici, dice, diciamo, dite, dicono. Used a lot in conversation. 'Cosa dici?' = What are you saying? 'Come si dice...?' (from Unit 1) literally means 'How does one say...?'",
      "before_exercise": 13
    }
  ],
