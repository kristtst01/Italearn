{
  "id": "unit-12-lesson-05",
  "unit_id": "unit-12",
  "name": "Movement & Useful Verbs",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-12-lesson-05-tip-01",
      "title": "Movement",
      "explanation": "'Girare' (to turn / go around), 'seguire' (to follow), 'incontrare' (to meet), 'scappare' (to escape / run away). Useful when navigating a city.",
      "before_exercise": 0
    },
    {
      "id": "unit-12-lesson-05-tip-02",
      "title": "Trying & Succeeding",
      "explanation": "'Riuscire' (to manage / succeed) and 'bastare' (to be enough): 'Non riesco a venire' = I can't manage to come. 'Basta!' = Enough!",
      "before_exercise": 6
    },
    {
      "id": "unit-12-lesson-05-tip-03",
      "title": "Becoming & Continuing",
      "explanation": "'Diventare' (to become), 'cominciare' (to begin), 'continuare' (to continue), 'trattare' (to treat / deal with).",
      "before_exercise": 11
    }
  ],
