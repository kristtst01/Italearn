  "vocabulary": [
    { "word": "lontano", "meaning": "far, far away · lontano da = far from", "example": "La stazione è lontano da qui?" },
    { "word": "davanti", "meaning": "in front · davanti a = in front of", "example": "Marco è davanti alla chiesa." },
    { "word": "dietro", "meaning": "behind · dietro la stazione, or dietro alla stazione", "example": "Il parcheggio è dietro la stazione." },
    { "word": "accanto", "meaning": "next to it · accanto a = next to", "example": "La farmacia è accanto alla banca." },
    { "word": "di fronte", "meaning": "opposite · di fronte a = opposite", "example": "Il bar è di fronte alla posta." },
    { "word": "sopra", "meaning": "on, on top of, above", "example": "Le chiavi sono sopra il tavolo." },
    { "word": "sotto", "meaning": "under, below · sotto casa = downstairs, just outside the building", "example": "Il gatto è sotto il letto." },
    { "word": "fuori", "meaning": "outside, out", "example": "Marco aspetta fuori." },
    { "word": "là", "meaning": "there, over there (like lì)", "example": "Il bar è là, in piazza." }
  ]
