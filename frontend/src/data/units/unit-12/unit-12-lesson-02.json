{
  "id": "unit-12-lesson-02",
  "unit_id": "unit-12",
  "name": "Venire & Uscire",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-12-lesson-02-tip-01",
      "title": "Venire — G-Insertion",
      "explanation": "'Venire' (to come) adds a 'g' in the io and loro forms: vengo (io), vieni (tu), viene (lui/lei), veniamo (noi), venite (voi), vengono (loro). Boot pattern again.",
      "before_exercise": 0
    },
    {
      "id": "unit-12-lesson-02-tip-02",
      "title": "Uscire — Vowel Change",
      "explanation": "'Uscire' (to go out) changes its root vowel u→e in four forms: esco (io), esci (tu), esce (lui/lei), usciamo (noi), uscite (voi), escono (loro). Boot pattern with a twist.",
      "before_exercise": 6
    },
    {
      "id": "unit-12-lesson-02-tip-03",
      "title": "Venire Da, Uscire Con",
      "explanation": "'Venire da' = to come from: 'Vengo da Roma'. 'Uscire con' = to go out with: 'Esco con gli amici'. Learn these prepositions with the verb.",
      "before_exercise": 11
    }
  ],
