{
  "id": "unit-12-lesson-01",
  "unit_id": "unit-12",
  "name": "Fare & Andare",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-12-lesson-01-tip-01",
      "title": "Fare — Completely Irregular",
      "explanation": "'Fare' (to do / to make) is one of the most useful verbs in Italian. Its forms are irregular: faccio (io), fai (tu), fa (lui/lei), facciamo (noi), fate (voi), fanno (loro). You'll use it constantly.",
      "before_exercise": 0
    },
    {
      "id": "unit-12-lesson-01-tip-02",
      "title": "Fare Idioms",
      "explanation": "Italians use 'fare' for many activities: fare colazione (eat breakfast), fare la spesa (do the grocery shopping), fare sport (play sport), fare un viaggio (take a trip). These are fixed phrases — learn them as chunks.",
      "before_exercise": 6
    },
    {
      "id": "unit-12-lesson-01-tip-03",
      "title": "Andare — The Boot Pattern",
      "explanation": "'Andare' (to go) is irregular only in 4 forms: vado (io), vai (tu), va (lui/lei), vanno (loro). The 'noi' and 'voi' forms are regular: andiamo, andate. This is the 'boot' pattern — irregular at the corners, regular in the middle.",
      "before_exercise": 11
    },
    {
      "id": "unit-12-lesson-01-tip-04",
      "title": "Andare A",
      "explanation": "'Andare a' + place: 'vado a Roma' (cities), 'vado a casa' (home), 'vado al cinema' (the cinema). 'Andare a' + infinitive means going TO DO something: 'vado a mangiare' (I'm going to eat).",
      "before_exercise": 17
    }
  ],
