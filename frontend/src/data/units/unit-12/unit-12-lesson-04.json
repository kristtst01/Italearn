{
  "id": "unit-12-lesson-04",
  "unit_id": "unit-12",
  "name": "More Action Verbs",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-12-lesson-04-tip-01",
      "title": "Coming, Going & Staying",
      "explanation": "Beyond andare/venire/uscire: 'tornare' (to return), 'entrare' (to enter), 'restare'/'rimanere' (to stay/remain), 'passare' (to pass / drop by).",
      "before_exercise": 0
    },
    {
      "id": "unit-12-lesson-04-tip-02",
      "title": "Carrying & Giving",
      "explanation": "'Portare' (to bring / wear), 'lasciare' (to leave / let), 'tenere' (to keep / hold), 'aiutare' (to help). 'Lasciare' is also used like English 'let': 'Lascia stare' = Let it be.",
      "before_exercise": 7
    },
    {
      "id": "unit-12-lesson-04-tip-03",
      "title": "Daily Actions",
      "explanation": "'Cambiare' (to change), 'usare' (to use), 'mandare' (to send), 'controllare' (to check), 'iniziare' (to start) — all regular -are verbs.",
      "before_exercise": 14
    }
  ],
