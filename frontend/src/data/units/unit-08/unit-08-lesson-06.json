{
  "id": "unit-08-lesson-06",
  "unit_id": "unit-08",
  "name": "People & Life",
  "order": 6,
  "grammar_tips": [
    {
      "id": "unit-08-lesson-06-tip-01",
      "title": "People in General",
      "explanation": "Beyond family, useful people-words: 'la persona' (person), 'la gente' (people — always singular!), 'qualcuno' (someone), 'il gruppo' (group). 'La gente' takes singular verbs: 'La gente è gentile' = People are kind.",
      "before_exercise": 0
    },
    {
      "id": "unit-08-lesson-06-tip-02",
      "title": "Signore & Signora",
      "explanation": "'Il signore' / 'la signora' = the man / the woman (formal). Also used as titles before a name: 'il signor Rossi' (Mr Rossi), 'la signora Bianchi' (Mrs Bianchi). The -e drops before a name.",
      "before_exercise": 6
    },
    {
      "id": "unit-08-lesson-06-tip-03",
      "title": "Life & Love",
      "explanation": "'La vita' (life) and 'l'amore' (love). 'Ho una bella vita' = I have a nice life. 'L'amore è importante' = Love is important.",
      "before_exercise": 11
    }
  ],
