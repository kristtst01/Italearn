{
  "id": "unit-08-lesson-04",
  "unit_id": "unit-08",
  "name": "Possessives I — Mio, Tuo, Suo",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-08-lesson-04-tip-01",
      "title": "Possessives Agree With the Thing",
      "explanation": "Italian possessives agree with the thing owned, not the owner. 'Il mio libro' (my book, masculine), 'la mia casa' (my house, feminine). 'Suo' covers both his AND her: 'il suo cane' = his/her dog.",
      "before_exercise": 0
    },
    {
      "id": "unit-08-lesson-04-tip-02",
      "title": "Use the Article",
      "explanation": "Normally a possessive takes the definite article: 'il mio cane', 'la tua macchina', 'il suo libro'. Don't drop the 'il' or 'la'.",
      "before_exercise": 7
    },
    {
      "id": "unit-08-lesson-04-tip-03",
      "title": "The Family Exception",
      "explanation": "With ONE family member, drop the article: 'mio padre' (not 'il mio padre'), 'tua sorella', 'sua madre'. The rule only applies to a single, unmodified family member.",
      "before_exercise": 13
    },
    {
      "id": "unit-08-lesson-04-tip-04",
      "title": "But Plural Family Keeps the Article",
      "explanation": "When the family member is plural, the article comes back: 'i miei fratelli' (my brothers), 'le tue sorelle' (your sisters), 'i miei nonni' (my grandparents).",
      "before_exercise": 19
    }
  ],
