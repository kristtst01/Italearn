{
  "id": "unit-08-lesson-02",
  "unit_id": "unit-08",
  "name": "Grandparents, Uncles & Cousins",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-08-lesson-02-tip-01",
      "title": "Extended Family",
      "explanation": "Grandparents, uncles, aunts, cousins — these follow the same -o/-a pattern: nonno/nonna, zio/zia, cugino/cugina. Once you know the masculine form, the feminine is one letter away.",
      "before_exercise": 0
    },
    {
      "id": "unit-08-lesson-02-tip-02",
      "title": "Nipote — Two Meanings",
      "explanation": "'Il nipote' or 'la nipote' can mean grandson/granddaughter OR nephew/niece. Context (or asking 'di chi?') tells you which.",
      "before_exercise": 8
    },
    {
      "id": "unit-08-lesson-02-tip-03",
      "title": "Plural Family",
      "explanation": "Plurals follow the noun rules: nonni (grandparents), zii (uncles/uncles+aunts), cugini (cousins). The masculine plural can include a mixed group: 'i miei nonni' = both grandparents.",
      "before_exercise": 14
    }
  ],
