{
  "id": "unit-08-lesson-05",
  "unit_id": "unit-08",
  "name": "Possessives II — Nostro, Vostro, Loro",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-08-lesson-05-tip-01",
      "title": "Nostro & Vostro",
      "explanation": "'Nostro' (our) and 'vostro' (your, for more than one person) agree like 'mio': 'il nostro libro', 'la vostra casa', 'i nostri amici'.",
      "before_exercise": 0
    },
    {
      "id": "unit-08-lesson-05-tip-02",
      "title": "Loro Never Changes",
      "explanation": "'Loro' (their) is invariable — it never changes: 'il loro cane', 'la loro casa', 'i loro figli'. And unlike other possessives, it always keeps the article — even with family: 'la loro madre'.",
      "before_exercise": 6
    },
    {
      "id": "unit-08-lesson-05-tip-03",
      "title": "Family Rule Recap",
      "explanation": "The family-no-article rule still applies to nostro/vostro with singular family: 'nostro padre' (not 'il nostro padre'), 'vostra madre'. But never with 'loro': always 'la loro madre'.",
      "before_exercise": 13
    }
  ],
