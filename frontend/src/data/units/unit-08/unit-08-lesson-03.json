  "name": "Husband, Wife & Kids",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-08-lesson-03-tip-01",
      "title": "Married Couples",
      "explanation": "'Marito' (husband) and 'moglie' (wife) don't follow the -o/-a pattern — they're different words. 'Moglie' is an exception: feminine, ending in -e, plural 'mogli'.",
      "before_exercise": 0
    },
    {
      "id": "unit-08-lesson-03-tip-02",
      "title": "Bambino, Bambina",
      "explanation": "'Bambino/bambina' means a child — small enough that you'd say 'kid' in English. For an adult son or daughter, use 'figlio/figlia' from Lesson 1.",
      "before_exercise": 6
    },
    {
      "id": "unit-08-lesson-03-tip-03",
      "title": "Boyfriend or Just a Boy?",
      "explanation": "'Ragazzo' (Unit 3) can mean 'boy' or 'boyfriend' depending on context. 'Fidanzato/fidanzata' is more specific — engaged or in a serious relationship.",
      "before_exercise": 11
    }
  ],
