{
  "id": "unit-08-lesson-01",
  "unit_id": "unit-08",
  "name": "Close Family",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-08-lesson-01-tip-01",
      "title": "Family Pairs",
      "explanation": "Many family words come in -o/-a pairs: figlio/figlia (son/daughter). The gender rule you already know carries straight over.",
      "before_exercise": 0
    },
    {
      "id": "unit-08-lesson-01-tip-02",
      "title": "Mamma & Papà",
      "explanation": "'Mamma' and 'papà' are the warm, everyday words — like 'mum' and 'dad'. 'Madre' and 'padre' are slightly more formal. Both are correct and common.",
      "before_exercise": 7
    },
    {
      "id": "unit-08-lesson-01-tip-03",
      "title": "Famiglia & Genitori",
      "explanation": "'La famiglia' (the family) is feminine. 'I genitori' (the parents) is masculine plural — it covers your mother and father together.",
      "before_exercise": 12
    }
  ],
  "exercises": [
