  "name": "Question Words",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-11-lesson-01-tip-01",
      "title": "Italian Question Words",
      "explanation": "Italian question words are short and stand at the start: dove (where), cosa (what), quando (when), come (how), perché (why), chi (who), quale (which), quanto (how much).",
      "before_exercise": 0
    },
    {
      "id": "unit-11-lesson-01-tip-02",
      "title": "Question Order",
      "explanation": "Italian doesn't need 'do' like English. 'Dove abiti?' = 'Where do you live?' Just question word + verb + the rest. No 'do', no 'are' to invert.",
      "before_exercise": 8
    },
    {
      "id": "unit-11-lesson-01-tip-03",
      "title": "Che vs Cosa vs Che Cosa",
      "explanation": "'Che?', 'Cosa?' and 'Che cosa?' all mean 'what?'. 'Cosa?' is the most common in everyday speech. 'Che?' is shorter and informal. They are interchangeable.",
      "before_exercise": 14
    }
  ],
