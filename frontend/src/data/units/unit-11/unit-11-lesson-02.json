{
  "id": "unit-11-lesson-02",
  "unit_id": "unit-11",
  "name": "Saying No & But",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-11-lesson-02-tip-01",
      "title": "Non Before the Verb",
      "explanation": "To make a sentence negative, put 'non' right before the verb: 'Non parlo francese' (I don't speak French), 'Non capisco' (I don't understand). One word does all the work.",
      "before_exercise": 0
    },
    {
      "id": "unit-11-lesson-02-tip-02",
      "title": "Niente & Nessuno",
      "explanation": "'Niente' (nothing) and 'nessuno' (no one) are used WITH 'non': 'Non mangio niente' (I eat nothing / I'm not eating anything), 'Non c'è nessuno' (No one is here). Italian uses the double negative; it's not wrong.",
      "before_exercise": 7
    },
    {
      "id": "unit-11-lesson-02-tip-03",
      "title": "Ma vs Però",
      "explanation": "'Ma' and 'però' both mean 'but'. 'Ma' is more common, used at the start of a clause. 'Però' is slightly stronger ('however') and can come at the end: 'Studio italiano, però è difficile' or 'Studio italiano, ma è difficile'.",
      "before_exercise": 13
    }
  ],
  "exercises": [
