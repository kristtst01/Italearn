{
  "id": "unit-11-lesson-05",
  "unit_id": "unit-11",
  "name": "Mental Verbs",
  "order": 5,
  "grammar_tips": [
    {
      "id": "unit-11-lesson-05-tip-01",
      "title": "Pensare & Sapere",
      "explanation": "'Pensare' (to think) is regular -are. 'Sapere' (to know a fact) is irregular: so, sai, sa, sappiamo, sapete, sanno. Different from 'conoscere' which is for people/places.",
      "before_exercise": 0
    },
    {
      "id": "unit-11-lesson-05-tip-02",
      "title": "Remembering & Forgetting",
      "explanation": "'Ricordare' (to remember) and 'dimenticare' (to forget) — direct opposites. 'Non ricordo' / 'Ho dimenticato'.",
      "before_exercise": 7
    },
    {
      "id": "unit-11-lesson-05-tip-03",
      "title": "Sembra Che... — It Seems",
      "explanation": "'Sembrare' (to seem) and 'parere' (to seem / think) are similar. 'Mi sembra' / 'Mi pare' = 'It seems to me'. 'Cosa significa?' = What does it mean?",
      "before_exercise": 13
    }
  ],
