{
  "id": "unit-11-lesson-06",
  "unit_id": "unit-11",
  "name": "Common Nouns",
  "order": 6,
  "grammar_tips": [
    {
      "id": "unit-11-lesson-06-tip-01",
      "title": "Abstract Conversation Nouns",
      "explanation": "Italian conversation depends on a small core of abstract nouns: modo (way), momento (moment), parte (part), tipo (type), caso (case), storia (story), fine (end), punto (point).",
      "before_exercise": 0
    },
    {
      "id": "unit-11-lesson-06-tip-02",
      "title": "Posto, Numero, Senso",
      "explanation": "'Il posto' (place/spot), 'il numero' (number), 'il senso' (sense/meaning). 'Non ha senso' = It makes no sense.",
      "before_exercise": 7
    },
    {
      "id": "unit-11-lesson-06-tip-03",
      "title": "Informal Words",
      "explanation": "'La roba' = stuff (informal). 'Un affare' = a deal / matter ('Che affare!' = What a deal!). 'Il ricordo' = a memory (the noun from ricordare).",
      "before_exercise": 12
    }
  ],
