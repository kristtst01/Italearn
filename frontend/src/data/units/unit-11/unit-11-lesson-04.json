{
  "id": "unit-11-lesson-04",
  "unit_id": "unit-11",
  "name": "Connectors & Discourse",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-11-lesson-04-tip-01",
      "title": "Time Sequence",
      "explanation": "Connect events in time: 'prima' (before/first), 'poi' (then), 'dopo' (after). 'Prima mangio, poi lavoro' = First I eat, then I work.",
      "before_exercise": 0
    },
    {
      "id": "unit-11-lesson-04-tip-02",
      "title": "So & Therefore",
      "explanation": "'Allora' (so / then) starts many Italian sentences. 'Quindi' (so / therefore) is more logical. 'Così' (so / thus) often shows result: 'Così è meglio' = This way it's better.",
      "before_exercise": 7
    },
    {
      "id": "unit-11-lesson-04-tip-03",
      "title": "Really & Almost",
      "explanation": "'Davvero' and 'veramente' both mean 'really / truly'. 'Quasi' = almost. 'Appena' = just / barely. 'Abbastanza' = enough / quite.",
      "before_exercise": 14
    }
  ],
