{
  "id": "unit-11-lesson-03",
  "unit_id": "unit-11",
  "name": "How Often?",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-11-lesson-03-tip-01",
      "title": "Adverbs After the Verb",
      "explanation": "Frequency adverbs come AFTER the conjugated verb: 'Lavoro sempre la mattina' (I always work in the morning). Not 'Sempre lavoro' — that sounds strange.",
      "before_exercise": 0
    },
    {
      "id": "unit-11-lesson-03-tip-02",
      "title": "Mai Needs Non",
      "explanation": "'Mai' (never) needs 'non' before the verb: 'Non mangio mai la carne' (I never eat meat). It's the same double-negative pattern as 'non...niente'.",
      "before_exercise": 7
    },
    {
      "id": "unit-11-lesson-03-tip-03",
      "title": "How Often Counts",
      "explanation": "From most to least often: sempre (always), di solito (usually), spesso (often), qualche volta (sometimes), raramente (rarely), mai (never). 'Ogni giorno' (every day) means daily.",
      "before_exercise": 14
    }
  ],
