  "grammar_tips": [
    {
      "id": "unit-17-lesson-02-tip-01",
      "title": "Clothing Items",
      "explanation": "Common clothes: la maglia (shirt / top), la camicia (button shirt), i pantaloni (trousers — always plural!), la gonna (skirt), il vestito (dress / suit), la giacca (jacket), il cappotto (coat).",
      "before_exercise": 0
    },
    {
      "id": "unit-17-lesson-02-tip-02",
      "title": "Pantaloni Is Plural",
      "explanation": "'I pantaloni' (trousers / pants) is always plural in Italian, like in English. Use 'i' + plural adjective: 'i pantaloni neri'.",
      "before_exercise": 7
    },
    {
      "id": "unit-17-lesson-02-tip-03",
      "title": "Footwear",
      "explanation": "'Le scarpe' (shoes) is feminine plural. 'I calzini' (socks) is masculine plural. Both are always plural — like in English.",
      "before_exercise": 13
    }
  ],
