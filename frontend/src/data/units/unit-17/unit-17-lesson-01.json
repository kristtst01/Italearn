{
  "id": "unit-17-lesson-01",
  "unit_id": "unit-17",
  "name": "Questo & Quello",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-17-lesson-01-tip-01",
      "title": "This and That",
      "explanation": "'Questo' (this) and 'quello' (that) are demonstratives — they point at things. 'Questo' is for things near you, 'quello' is for things farther away.",
      "before_exercise": 0
    },
    {
      "id": "unit-17-lesson-01-tip-02",
      "title": "Forms of Questo",
      "explanation": "Questo agrees like an adjective: questo (masc sg), questa (fem sg), questi (masc pl), queste (fem pl). 'Questo libro', 'questa borsa', 'questi pantaloni', 'queste scarpe'.",
      "before_exercise": 6
    },
    {
      "id": "unit-17-lesson-01-tip-03",
      "title": "Forms of Quello",
      "explanation": "'Quello' behaves like the definite article fused: quel (il), quello (lo/z/s+cons), quella (la), quell' (vowel), quei (i), quegli (gli/z/s+cons), quelle (le). Easier in practice than it looks: quel libro, quella borsa, quei libri.",
      "before_exercise": 12
    }
  ],
