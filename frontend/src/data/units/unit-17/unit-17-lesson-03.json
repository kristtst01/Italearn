  "grammar_tips": [
    {
      "id": "unit-17-lesson-03-tip-01",
      "title": "Accessories",
      "explanation": "Common accessories: la sciarpa (scarf), i guanti (gloves), la cintura (belt), gli occhiali (glasses — always plural in Italian too), l'anello (ring).",
      "before_exercise": 0
    },
    {
      "id": "unit-17-lesson-03-tip-02",
      "title": "Asking for a Size",
      "explanation": "'Che taglia hai?' = 'What size are you?'. 'Ho la taglia M' / 'la taglia media' / 'la taglia 42'. Italian uses letters (S/M/L) or numbers.",
      "before_exercise": 6
    },
    {
      "id": "unit-17-lesson-03-tip-03",
      "title": "Provare — To Try On",
      "explanation": "'Vorrei provare questa maglia' = I'd like to try on this top. 'Provare' is a regular -are verb: provo, provi, prova...",
      "before_exercise": 11
    }
  ],
