{
  "id": "unit-17-lesson-04",
  "unit_id": "unit-17",
  "name": "Money & Prices",
  "order": 4,
  "grammar_tips": [
    {
      "id": "unit-17-lesson-04-tip-01",
      "title": "Euros and Prices",
      "explanation": "Italy uses the euro: '20 euro', '50 euro'. 'Euro' is invariable — never 'euros' in Italian. 'Quanto costa?' = How much does it cost? 'Costa venti euro' = It costs €20.",
      "before_exercise": 0
    },
    {
      "id": "unit-17-lesson-04-tip-02",
      "title": "Cheap or Expensive",
      "explanation": "'Caro' (expensive — you know it from Unit 6) and 'economico' (cheap) are key when shopping. 'Questo è caro!' = This is expensive!",
      "before_exercise": 7
    },
    {
      "id": "unit-17-lesson-04-tip-03",
      "title": "Paying",
      "explanation": "'Pagare' (to pay) is regular -are. 'Pago in contanti' (I pay in cash) or 'pago con la carta' (I pay by card). 'Sconto' = discount.",
      "before_exercise": 13
    }
  ],
