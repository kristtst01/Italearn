{
  "id": "unit-15-lesson-02",
  "unit_id": "unit-15",
  "name": "Potere & Dovere — Can & Must",
  "order": 2,
  "grammar_tips": [
    {
      "id": "unit-15-lesson-02-tip-01",
      "title": "Potere — Can / Be Able To",
      "explanation": "'Potere': posso (io), puoi (tu), può (lui/lei), possiamo (noi), potete (voi), possono (loro). Used for ability and permission: 'Posso entrare?' = May I come in? 'Non posso venire' = I can't come.",
      "before_exercise": 0
    },
    {
      "id": "unit-15-lesson-02-tip-02",
      "title": "Dovere — Must / Have To",
      "explanation": "'Dovere': devo (io), devi (tu), deve (lui/lei), dobbiamo (noi), dovete (voi), devono (loro). Used for obligation: 'Devo andare' = I have to go. 'Devi studiare' = You have to study.",
      "before_exercise": 7
    },
    {
      "id": "unit-15-lesson-02-tip-03",
      "title": "Modal + Infinitive",
      "explanation": "Like 'volere', both 'potere' and 'dovere' are followed by an infinitive: 'posso venire', 'devo lavorare', 'voglio mangiare'. Never another conjugated verb.",
      "before_exercise": 14
    }
  ],
