{
  "id": "unit-15-lesson-03",
  "unit_id": "unit-15",
  "name": "Inviting & Planning",
  "order": 3,
  "grammar_tips": [
    {
      "id": "unit-15-lesson-03-tip-01",
      "title": "Inviting Someone",
      "explanation": "To invite a friend: 'Vuoi venire al cinema?' = Do you want to come to the cinema? Or with 'volere' + infinitive: 'Vuoi mangiare con me stasera?'. Italians often phrase invitations as questions.",
      "before_exercise": 0
    },
    {
      "id": "unit-15-lesson-03-tip-02",
      "title": "Saying Yes or No to Plans",
      "explanation": "Yes: 'Va bene', 'D'accordo', 'Volentieri' (with pleasure). No: 'Mi dispiace, non posso' (Sorry, I can't), 'Devo lavorare' (I have to work). Soft refusals work best.",
      "before_exercise": 6
    },
    {
      "id": "unit-15-lesson-03-tip-03",
      "title": "Free or Busy",
      "explanation": "'Sono libero/a' = I'm free. 'Sono occupato/a' = I'm busy. Like all adjectives, they agree with the speaker's gender.",
      "before_exercise": 11
    }
  ],
