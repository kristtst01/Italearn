{
  "id": "unit-15-lesson-01",
  "unit_id": "unit-15",
  "name": "Volere — Wanting",
  "order": 1,
  "grammar_tips": [
    {
      "id": "unit-15-lesson-01-tip-01",
      "title": "Volere — To Want",
      "explanation": "'Volere' is irregular: voglio (io), vuoi (tu), vuole (lui/lei), vogliamo (noi), volete (voi), vogliono (loro). Boot pattern again — irregular at the edges, regular in the middle.",
      "before_exercise": 0
    },
    {
      "id": "unit-15-lesson-01-tip-02",
      "title": "Volere + Noun or Infinitive",
      "explanation": "'Voglio un caffè' (I want a coffee). 'Voglio mangiare' (I want to eat). After 'volere', a noun OR an infinitive — never another conjugated verb.",
      "before_exercise": 7
    },
    {
      "id": "unit-15-lesson-01-tip-03",
      "title": "Vorrei — Politely",
      "explanation": "'Vorrei' (I would like) is the polite form of 'voglio'. At a restaurant or shop, always use 'vorrei': 'Vorrei un caffè, per favore'. Sounds gentle and adult.",
      "before_exercise": 13
    }
  ],
