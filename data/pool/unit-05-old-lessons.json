          "correct_answer": "Quanti anni hai?",
          "distractors": [
            "Come stai?",
            "Di dove sei?",
            "Come ti chiami?"
          ],
          "hints": [
            "Literally: 'How many years do you have?'"
          ],
          "target_words": [
